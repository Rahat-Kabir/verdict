---
import Base from "../../layouts/Base.astro";
import results from "../../data/results.json";

export async function getStaticPaths() {
  const meta = (results.providers_meta ?? {}) as Record<string, any>;
  const summary = (results.summary?.providers ?? {}) as Record<string, any>;
  const names = new Set([...Object.keys(meta), ...Object.keys(summary)]);
  return Array.from(names).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const meta = (results.providers_meta?.[id] ?? {}) as any;
const suites = (results.summary?.providers?.[id] ?? {}) as Record<string, any>;

const fmtAcc = (v: number | null) => (v === null || v === undefined ? "–" : `${(v * 100).toFixed(1)}%`);
const fmtMs = (v: number | null) => (v === null || v === undefined ? "–" : `${Math.round(v)}`);
const fmtCost = (v: number | null) => {
  if (v === null || v === undefined) return "n/a";
  if (v < 0.01) return `$${v.toFixed(4)}`;
  return `$${v.toFixed(3)}`;
};
const fmtEce = (v: number | null) => (v === null || v === undefined ? "–" : v.toFixed(3));
const suiteName = (s: string) => s.replace("_", " ");
---

<Base title={`${meta.display_name ?? id} — Verdict`}>
  <p style="margin-top:26px"><a href="/historical">&#8592; leaderboard</a></p>
  <h1>{meta.display_name ?? id}</h1>
  <p class="tagline">
    <strong>{meta.vendor ?? "unknown vendor"}</strong>
    &middot; model <code>{meta.model ?? id}</code>
    {((meta.labels ?? []) as string[]).map((l) => <span class={`badge ${l}`}>{l}</span>)}
  </p>
  <p class="tagline">{meta.description ?? ""}</p>
  <p class="callout">
    Historical snapshot: these measurements predate parser, pricing, and accounting corrections.
    Results apply to the recorded tasks and adapter, with <a href="/methodology">the limitations described in methodology</a>.
  </p>
  {meta.url && <p><a href={meta.url} rel="noopener" target="_blank">provider page ↗</a></p>}

  {Object.keys(suites).length === 0 && <div class="callout">No benchmark data recorded for this provider yet.</div>}

  {Object.entries(suites).map(([suite, m]: [string, any]) => (
    <>
      <h2>{suiteName(suite)}</h2>
      <table class="board">
        <thead>
          <tr><th>Metric</th><th>Value</th><th>Note</th></tr>
        </thead>
        <tbody>
          <tr><td>Accuracy (successful responses)</td><td class="num">{fmtAcc(m.accuracy)}</td><td>{m.n} items, {m.n_errors} failed items excluded from this accuracy</td></tr>
          <tr><td>Completion rate</td><td class="num">{fmtAcc(m.completion_rate)}</td><td>successful responses / all items</td></tr>
          <tr><td>Accuracy (all items)</td><td class="num">{fmtAcc(m.accuracy_all_items)}</td><td>correct successful responses / all items; failures count as incorrect</td></tr>
          <tr><td>Latency p50 / p95</td><td class="num">{fmtMs(m.latency_ms_p50)} / {fmtMs(m.latency_ms_p95)} ms</td><td>historical client timing over all items, including failures</td></tr>
          <tr><td>Cost per 1,000 items</td><td class="num">{fmtCost(m.cost_per_1k_usd)}</td><td>includes failed items; unknown unless every item has a recorded cost</td></tr>
          <tr><td>Cost coverage</td><td class="num">{m.n_with_cost ?? "?"}/{m.n}</td><td>items with known cost / all items; historical billing basis was not retained</td></tr>
          <tr><td>Total recorded cost</td><td class="num">{fmtCost(m.total_cost_usd)}</td><td>unknown when billing coverage is incomplete</td></tr>
          <tr><td>Known recorded cost subtotal</td><td class="num">{fmtCost(m.known_cost_total_usd)}</td><td>partial sum when costs are missing; does not establish total spend</td></tr>
          <tr><td>Calibration (ECE)</td><td class="num">{fmtEce(m.ece)}</td><td>{m.n_with_confidence} items reported confidence</td></tr>
        </tbody>
      </table>

      {m.escalation && Object.keys(m.escalation).length > 0 && (
        <>
          <h3 style="margin-top:22px; font-size:15px; color:var(--muted)">
            Offline escalation simulation with GPT-6 Luna
          </h3>
          <p class="tagline">Uses previously recorded answers. Failed escalation retains the primary answer
            and adds recorded cost and time. Missing escalation observations make simulated accuracy,
            cost, and latency unknown. Thresholds were not validated on held-out data.</p>
          <table class="board">
            <thead>
              <tr><th>Threshold</th><th>Accuracy (successful)</th><th>Accuracy (all)</th><th>Blended $/1k</th><th>Cost coverage</th><th>p50 / p95 ms</th><th>Escalation attempts</th><th>Failed / missing</th></tr>
            </thead>
            <tbody>
              {Object.entries(m.escalation).map(([t, e]: [string, any]) => (
                <tr>
                  <td class="num">{t}</td>
                  <td class="num">{fmtAcc(e.accuracy)}</td>
                  <td class="num">{fmtAcc(e.accuracy_all_items)}</td>
                  <td class="num">{fmtCost(e.cost_per_1k_usd)}</td>
                  <td class="num">{e.n_with_cost ?? "?"}/{e.n ?? "?"}</td>
                  <td class="num">{fmtMs(e.latency_ms_p50)} / {fmtMs(e.latency_ms_p95)}</td>
                  <td class="num">{e.escalated_pct}%</td>
                  <td class="num">{e.n_failed_escalations ?? "?"} / {e.n_missing_escalations ?? "?"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )}
    </>
  ))}
</Base>
