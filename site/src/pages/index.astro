---
import Base from "../layouts/Base.astro";
import results from "../data/results.json";

const suites = Object.keys(results.leaderboards || {});
const activeSuite = suites[0] || "";

const fmtAcc = (v: number | null) => (v === null || v === undefined ? "–" : `${(v * 100).toFixed(1)}%`);
const fmtMs = (v: number | null) => (v === null || v === undefined ? "–" : `${Math.round(v)}`);
const fmtCost = (v: number | null) => {
  if (v === null || v === undefined) return "n/a";
  if (v < 0.01) return `$${v.toFixed(4)}`;
  return `$${v.toFixed(3)}`;
};
const fmtEce = (v: number | null) => (v === null || v === undefined ? "–" : v.toFixed(3));

function badgeClass(label: string) {
  return ["proxy", "frontier", "decision-model"].includes(label) ? label : "";
}

const hasData = suites.length > 0;
---

<Base title="Verdict — historical benchmark results">
  <h1>Finite-choice AI benchmark results</h1>
  <p class="tagline">
    An experimental comparison of chat baselines and Jev Router on labeled tasks.
    These tables describe a historical snapshot, with accuracy, client latency,
    recorded cost, and reported confidence. They do not establish production reliability.
  </p>
  <p class="updated">
    {results.generated_at ? `Summary generated: ${results.generated_at.replace(/Z$/, "")} (UTC); aggregation time, not inference time.` : "Summary generation time unavailable."}
  </p>
  <p class="callout">
    Historical evidence: these records predate parser, pricing, and accounting corrections.
    Raw outputs and token usage were not saved, so the snapshot cannot be repaired offline.
    Accuracy excludes failed responses; confidence thresholds have not been validated on held-out tasks.
    See <a href="/methodology">methodology and limitations</a> before interpreting ranks or costs.
  </p>

  {!hasData && (
    <div class="callout">
      No benchmark results yet. The harness runs via <code>verdict bench --all</code>; once
      <code>verdict aggregate</code> writes <code>site/src/data/results.json</code>, this page fills in.
    </div>
  )}

  {suites.length > 0 && (
    <>
      <div class="tabs">
        {suites.map((s) => (
          <a href={`#${s}`} class={s === activeSuite ? "active" : ""} data-tab={s}>
            {s.replace("_", " ")} <span style="opacity:.6">({results.suites?.[s]?.n_items ?? "?"})</span>
          </a>
        ))}
      </div>

      {suites.map((s, i) => {
        const rows = results.leaderboards[s] as any[];
        return (
          <section id={s} style={i === 0 ? "" : "display:none"}>
            <table class="board" id={`board-${s}`}>
              <thead>
                <tr>
                  <th>#</th><th>Provider</th>
                  <th data-num>Accuracy ▾</th><th data-num>p50 ms</th><th data-num>p95 ms</th>
                  <th data-num>$/1k decisions</th><th data-num>ECE ↓</th><th data-num>n</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => {
                  const meta = results.providers_meta[r.provider] ?? {};
                  const labels = (meta.labels ?? []) as string[];
                  return (
                    <tr>
                      <td class={`rank ${r.rank === 1 ? "top" : ""}`}>{r.rank}</td>
                      <td class="prov">
                        <a href={`/providers/${r.provider}`}>{meta.display_name ?? r.provider}</a>
                        {labels.map((l) => <span class={`badge ${badgeClass(l)}`}>{l}</span>)}
                      </td>
                      <td class={`num ${r.accuracy !== null && r.accuracy >= 0.9 ? "good" : ""}`}>{fmtAcc(r.accuracy)}</td>
                      <td class="num">{fmtMs(r.latency_ms_p50)}</td>
                      <td class="num">{fmtMs(r.latency_ms_p95)}</td>
                      <td class="num">{fmtCost(r.cost_per_1k_usd)}</td>
                      <td class="num">{fmtEce(r.ece)}</td>
                      <td class="num">{r.n}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </section>
        );
      })}
    </>
  )}

  <h2>What "cost" means here</h2>
  <p class="tagline">
    $/1k = average known cost per 1,000 decisions on that suite. Displayed costs come from the
    historical snapshot and have not been repaired with the corrected pricing and retry accounting.
    OpenAI costs are estimates. See the <a href="/methodology">methodology page</a> for billing limits.
    "n/a" means no cost could be resolved.
  </p>

  <script>
    // Suite tabs: show one section at a time (static build, client-side toggle).
    document.querySelectorAll<HTMLAnchorElement>("[data-tab]").forEach((tab) => {
      tab.addEventListener("click", (e) => {
        e.preventDefault();
        const target = tab.dataset.tab!;
        document.querySelectorAll<HTMLAnchorElement>("[data-tab]").forEach((t) =>
          t.classList.toggle("active", t === tab)
        );
        document.querySelectorAll<HTMLElement>("section[id]").forEach((sec) => {
          sec.style.display = sec.id === target ? "" : "none";
        });
        history.replaceState(null, "", `#${target}`);
      });
    });
    // Open the tab matching the URL hash if present.
    const hash = location.hash.slice(1);
    if (hash) document.querySelector<HTMLAnchorElement>(`[data-tab="${hash}"]`)?.click();
  </script>

  <script>
    // Click-to-sort on numeric columns.
    document.querySelectorAll<HTMLTableElement>("table.board").forEach((table) => {
      const headers = table.querySelectorAll<HTMLTableCellElement>("th[data-num]");
      headers.forEach((th, colIdx) => {
        th.addEventListener("click", () => {
          const tbody = table.tBodies[0];
          const rows = Array.from(tbody.rows);
          const parse = (cell: string) => {
            const s = cell.replace(/[$,%]/g, "").trim();
            if (s === "–" || s === "n/a") return -Infinity;
            const v = parseFloat(s);
            return isNaN(v) ? -Infinity : v;
          };
          const dir = th.dataset.dir === "asc" ? -1 : 1;
          th.dataset.dir = dir === 1 ? "asc" : "desc";
          rows.sort(
            (a, b) => dir * (parse(a.cells[colIdx].innerText) - parse(b.cells[colIdx].innerText))
          );
          rows.forEach((r) => tbody.appendChild(r));
        });
      });
    });
  </script>
</Base>
