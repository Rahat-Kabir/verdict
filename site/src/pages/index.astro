---
import Base from "../layouts/Base.astro";
import results from "../data/results.json";
import historicalDatasets from "../data/historical-datasets.json";

const suites = Object.keys(results.leaderboards || {});
const activeSuite = suites[0] || "";

// Original teaching examples explain the task shape without publishing private
// dataset text or claiming these inputs produced the historical measurements.
const taskExamples = {
  agent_next_action: {
    name: "Agent action", description: "Choose a support agent's next tool from six available actions.",
    question: "Which single tool should the support agent call next?",
    answers: ["lookup_order", "issue_refund", "check_payment_status", "escalate_to_human", "send_faq_link", "update_shipping_address"],
    input: "A customer asks where to find instructions for changing notification settings. A help article covers this question.",
    expected: "send_faq_link", reason: "The customer needs instructions, so the next action is to share the help article. This evaluates tool selection, not tool execution.",
  },
  classification: {
    name: "Text classification", description: "Assign a news headline to one of four categories.",
    question: "Which news category does this headline belong to?",
    answers: ["World", "Sports", "Business", "Sci/Tech"],
    input: "Local basketball team wins the championship after overtime.",
    expected: "Sports", reason: "The headline describes a sporting event.",
  },
  moderation: {
    name: "Content moderation", description: "Classify whether a text contains hate speech.",
    question: "Does this text contain hate speech? Choose hate or not_hate.",
    answers: ["hate", "not_hate"], input: "I enjoyed the community picnic and hope we hold another one soon.",
    expected: "not_hate", reason: "This example expresses a positive opinion without hateful content. These two labels do not cover every moderation concern.",
  },
  routing: {
    name: "Support routing", description: "Choose which support queue should handle a customer ticket.",
    question: "Which support team queue should handle this customer ticket?",
    answers: ["Technical Support", "Product Support", "Customer Service", "Billing and Payments"],
    input: "My invoice includes the same subscription charge twice. Please correct the duplicate charge.",
    expected: "Billing and Payments", reason: "The unresolved request concerns an invoice charge.",
  },
};

const fmtAcc = (v: number | null) => (v === null || v === undefined ? "–" : `${(v * 100).toFixed(1)}%`);
const fmtMs = (v: number | null) => (v === null || v === undefined ? "–" : `${Math.round(v)}`);
const fmtCost = (v: number | null) => {
  if (v === null || v === undefined) return "n/a";
  if (v < 0.01) return `$${v.toFixed(4)}`;
  return `$${v.toFixed(3)}`;
};
const fmtEce = (v: number | null) => (v === null || v === undefined ? "–" : v.toFixed(3));

function badgeClass(label: string) {
  return ["proxy", "frontier", "decision-model"].includes(label) ? label : "";
}

const hasData = suites.length > 0;
---

<Base title="Verdict — historical benchmark results">
  <p class="evaluation-label">Verdict internal evaluation · Historical results</p>
  <h1>Compare models on decision tasks</h1>
  <p class="tagline">
    Give a model a question, allowed answers, and an input. It chooses one answer.
    Explore an example below, then compare historical results on tasks with expected answers.
    These measurements come from our internal evaluation, not an independent assessment.
  </p>
  <a class="playground-link" href="/playground">Start in the playground &#8594;</a>
  <p class="results-note">Bring your own question, choices, and input to compare model answers.
    Or explore the saved evaluation examples below.</p>
  <p class="callout">
    Older experimental snapshot: these results predate parser and cost-accounting fixes.
    They do not establish production reliability. <a href="/methodology">Read the evidence limits.</a>
  </p>

  {!hasData && (
    <div class="callout">
      No benchmark results yet. The harness runs via <code>verdict bench --all</code>; once
      <code>verdict aggregate</code> writes <code>site/src/data/results.json</code>, this page fills in.
    </div>
  )}

  {suites.length > 0 && (
    <>
      <div class="tabs">
        {suites.map((s) => (
          <a href={`#${s}`} class={s === activeSuite ? "active" : ""} data-tab={s}>
            {taskExamples[s]?.name ?? s} <span style="opacity:.6">({results.suites?.[s]?.n_items ?? "?"})</span>
          </a>
        ))}
      </div>

      {suites.map((s, i) => {
        const rows = results.leaderboards[s] as any[];
        const example = taskExamples[s];
        const dataset = historicalDatasets[s];
        return (
          <section id={s} style={i === 0 ? "" : "display:none"}>
            {example && <article class="task-example" aria-labelledby={`example-${s}`}>
              <p class="example-label">Illustrative example · Not a recorded benchmark item</p>
              <h2 id={`example-${s}`}>{example.name}: what is the model deciding?</h2>
              <p class="task-description">{example.description}</p>
              <dl class="example-fields">
                <div><dt>Question</dt><dd>{example.question}</dd></div>
                <div><dt>Allowed answers</dt><dd class="answer-options">{example.answers.map(answer => <code>{answer}</code>)}</dd></div>
                <div><dt>Input</dt><dd>{example.input}</dd></div>
                <div><dt>Expected answer</dt><dd><strong class="expected-answer">{example.expected}</strong><p>{example.reason}</p></dd></div>
              </dl>
              <p class="example-note">This expected answer was assigned for explanation. The table below measures the historical dataset, not this example.</p>
            </article>}
            <h2>Historical results · {example?.name ?? s}</h2>
            {dataset && <div class="dataset-summary">
              <p><strong>{dataset.items} items · {dataset.unique_inputs} unique inputs</strong> · {dataset.input_status}</p>
              <p><strong>Label balance:</strong> {dataset.balance}</p>
              <details><summary>Dataset source and scope</summary><p>{dataset.source}</p><p>{dataset.limitation}</p></details>
            </div>}
            <p class="results-note">{results.suites?.[s]?.n_items ?? "Unknown number of"} items in the saved dataset.
              Accuracy counts correct answers among successful responses; completion shows how often a usable response was returned.</p>
            <div class="table-scroll" role="region" aria-label={`${example?.name ?? s} historical results`} tabindex="0">
            <table class="board" id={`board-${s}`}>
              <thead>
                <tr>
                  <th>Model / pipeline</th>
                  <th data-num data-sort-direction="desc" aria-sort="descending">Accuracy</th><th>Completion</th><th data-num>Median time (ms)</th>
                  <th data-num>Cost / 1,000 decisions</th><th data-num>Items tested</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => {
                  const meta = results.providers_meta[r.provider] ?? {};
                  const labels = (meta.labels ?? []) as string[];
                  return (
                    <tr>
                      <td class="prov">
                        <a href={`/providers/${r.provider}`}>{meta.display_name ?? r.provider}</a>
                        {labels.map((l) => <span class={`badge ${badgeClass(l)}`}>{l}</span>)}
                      </td>
                      <td data-sort-value={r.accuracy ?? ""} class={`num ${r.accuracy !== null && r.accuracy >= 0.9 ? "good" : ""}`}>{fmtAcc(r.accuracy)}</td>
                      <td class="num" title={`${r.n_errors} failed items`}>{fmtAcc(r.completion_rate)}</td>
                      <td data-sort-value={r.latency_ms_p50 ?? ""} class="num">{fmtMs(r.latency_ms_p50)}</td>
                      <td data-sort-value={r.cost_per_1k_usd ?? ""} class="num">{fmtCost(r.cost_per_1k_usd)}</td>
                      <td data-sort-value={r.n ?? ""} class="num">{r.n}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
            </div>
            <details class="metric-details">
              <summary>Additional metrics and definitions</summary>
              <p>Accuracy: correct answers / successful responses. Completion: successful responses / all attempts.
                Median time: half the recorded calls were faster and half slower. Cost / 1,000 decisions
                scales the recorded total across all attempts; it is not an invoice or a current price quote.</p>
              <p>95th-percentile time: 95% of recorded calls were at or below this time. Cost coverage:
                attempts with a recorded cost / all attempts, not verified billing. Calibration error (ECE):
                the observed gap between reported confidence and correctness; lower does not guarantee reliability.</p>
              <div class="table-scroll" role="region" aria-label={`${example?.name ?? s} additional metrics`} tabindex="0">
                <table class="board additional-metrics"><thead><tr><th>Model / pipeline</th><th data-num>95th-percentile time (ms)</th><th>Cost coverage</th><th data-num>Calibration error (ECE)</th></tr></thead>
                  <tbody>{rows.map(row => <tr>
                    <td>{results.providers_meta[row.provider]?.display_name ?? row.provider}</td>
                    <td class="num" data-sort-value={row.latency_ms_p95 ?? ""}>{fmtMs(row.latency_ms_p95)}</td>
                    <td class="num">{row.n_with_cost ?? "?"}/{row.n}</td>
                    <td class="num" data-sort-value={row.ece ?? ""}>{fmtEce(row.ece)}</td>
                  </tr>)}</tbody>
                </table>
              </div>
            </details>
          </section>
        );
      })}
    </>
  )}

  <aside class="latest-comparison">
    <strong>A separate comparison: Jev Direct, Clef, Clef Flash, and Nano</strong>
    <p>October 2 · 24 synthetic support tickets · all four returned 24/24 expected answers.
      Different providers and dataset from the historical tables above.</p>
    <a href="/comparison">Explore that comparison and its limits &#8594;</a>
  </aside>
  <details class="evidence-details">
    <summary>Historical evidence and run details</summary>
    <p>These records predate parser, pricing, and accounting corrections. Raw outputs and token usage
      were not saved, so this snapshot cannot be repaired offline. Confidence thresholds have not
      been validated on held-out tasks. Ranks describe this dataset, not a universal model ranking.</p>
    <p>Classification and moderation inputs are kept private. The original builder used Hugging Face
      sources and could fall back to generated examples; source revisions and row-level manifests
      were not retained. Archived inputs and records passed an integrity and label-alignment audit on
      October 4; this does not independently validate labels or original API calls. Agent action has
      200 items but only 105 distinct inputs. Internal evaluation
      describes who ran the experiment; it does not establish independent validation.</p>
    <p class="updated">
      {results.generated_at ? `Summary generated: ${results.generated_at.replace(/Z$/, "")} (UTC); aggregation time, not inference time.` : "Summary generation time unavailable."}
    </p>
  </details>

  <h2>What "cost" means here</h2>
  <p class="tagline">
    $/1k = total recorded cost divided by all items, including failures, multiplied by 1,000.
    It is shown only when every item has a known cost; cost coverage shows known costs / all items.
    Latency includes failed items. Displayed costs come from the
    historical snapshot and have not been repaired with the corrected pricing and retry accounting.
    OpenAI costs are estimates. See the <a href="/methodology">methodology page</a> for billing limits.
    "n/a" means the complete cost is unknown. A known zero remains zero.
  </p>

  <script>
    // Suite tabs: show one section at a time (static build, client-side toggle).
    document.querySelectorAll<HTMLAnchorElement>("[data-tab]").forEach((tab) => {
      tab.addEventListener("click", (e) => {
        e.preventDefault();
        const target = tab.dataset.tab!;
        document.querySelectorAll<HTMLAnchorElement>("[data-tab]").forEach((t) =>
          t.classList.toggle("active", t === tab)
        );
        document.querySelectorAll<HTMLElement>("section[id]").forEach((sec) => {
          sec.style.display = sec.id === target ? "" : "none";
        });
        history.replaceState(null, "", `#${target}`);
      });
    });
    // Open the tab matching the URL hash if present.
    const hash = location.hash.slice(1);
    if (hash) document.querySelector<HTMLAnchorElement>(`[data-tab="${hash}"]`)?.click();
  </script>

  <script>
    import { sortRowsByNumericColumn } from "../scripts/numeric-sort.js";

    // Click-to-sort on numeric columns.
    document.querySelectorAll<HTMLTableElement>("table.board").forEach((table) => {
      const headers = table.querySelectorAll<HTMLTableCellElement>("th[data-num]");
      headers.forEach((th) => {
        th.addEventListener("click", () => {
          const tbody = table.tBodies[0];
          const rows = Array.from(tbody.rows);
          const direction = th.dataset.sortDirection === "asc" ? "desc" : "asc";
          th.dataset.sortDirection = direction;
          headers.forEach((header) => header.removeAttribute("aria-sort"));
          th.setAttribute("aria-sort", direction === "asc" ? "ascending" : "descending");
          // cellIndex is the position in the full table, including non-sortable columns.
          sortRowsByNumericColumn(rows, th.cellIndex, direction).forEach((row) => tbody.appendChild(row));
        });
      });
    });
  </script>
</Base>

<style>
  .evaluation-label { color: var(--muted); font-size: 13px; margin: 26px 0 -12px; }
  .playground-link { display: inline-block; padding: 10px 16px; border-radius: 8px; background: var(--accent); color: var(--bg); font-weight: 600; margin: 4px 0; }
  .task-example { padding: 22px; border: 1px solid var(--border); background: var(--panel); border-radius: 12px; }
  .task-example h2 { margin: 6px 0; }
  .example-label, .task-description, .example-note, .results-note { color: var(--muted); font-size: 13px; }
  .example-label { margin: 0; }
  .example-fields { margin: 20px 0 0; }
  .example-fields > div { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-top: 1px solid var(--border); }
  .example-fields dt { color: var(--muted); font-size: 13px; }
  .example-fields dd { margin: 0; font-size: 14px; }
  .example-fields dd p { margin: 6px 0 0; color: var(--muted); }
  .answer-options { display: flex; flex-wrap: wrap; gap: 8px; }
  .expected-answer { color: var(--accent-2); }
  .table-scroll { overflow-x: auto; }
  .dataset-summary { font-size: 13px; color: var(--muted); padding: 12px 16px; background: var(--bg-soft); border-radius: 8px; }
  .dataset-summary p { margin: 4px 0 8px; }
  .dataset-summary summary, .metric-details summary { cursor: pointer; color: var(--accent); }
  .metric-details { margin-top: 16px; font-size: 13px; color: var(--muted); }
  table.board th:nth-child(2), table.board td:nth-child(2) { text-align: right; }
  .evidence-details { margin: 20px 0; color: var(--muted); font-size: 13px; }
  .evidence-details summary { cursor: pointer; }
  @media (max-width: 600px) { .example-fields > div { grid-template-columns: 1fr; gap: 6px; } .task-example { padding: 16px; } }
  .latest-comparison { border: 1px solid #2c5a48; background: #111f1d; padding: 16px 18px; border-radius: 12px; margin: 20px 0; }
  .latest-comparison p { color: var(--muted); font-size: 14px; margin: 6px 0 10px; }
</style>

<style>
  th[data-num][aria-sort="ascending"]::after { content: " ↑"; }
  th[data-num][aria-sort="descending"]::after { content: " ↓"; }
</style>
