# Verdict — provider API keys
# Copy this file to .env and fill in your real keys. Never commit .env.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cloudflare Workers AI (Clef / Clef Flash; explicit selection only)
# Dashboard: Workers AI > Use REST API. Token needs Workers AI Read/Edit permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=

# Optional: local models via Ollama (no key needed; leave blank to skip)
OLLAMA_BASE_URL=

# Optional classification/moderation JSONL inputs, obtained under source terms.
# Set in the process environment; keep this directory outside the repository.
VERDICT_DATASET_DIR=

# Playground keys use this file, but live/budget settings use process environment
# variables only. See docs/playground.md. Demo is the default; no paid requests.

# Optional: Clerk sign-in for live playground mode (publishable keys are public).
# Create an app at dashboard.clerk.com or run `clerk apps create`; `clerk env pull`
# writes PUBLIC_CLERK_PUBLISHABLE_KEY to site/.env for the frontend. Live mode
# verifies session JWTs against Clerk's public JWKS; no Clerk secret is used here.
CLERK_PUBLISHABLE_KEY=
